<?xml version="1.0" encoding="utf-8"?>
<!--
  主题图标（Android 13+）的单色层。

  不能直接复用彩色前景 —— 系统按 alpha 取形后整体着色，
  「白色实心卡片 + 画在卡片上的折线」会糊成一整块实心，折线反而看不见。
  所以这里改成两条描边：卡片轮廓 + 折线。

  颜色无所谓（系统只取 alpha），统一写白便于阅读。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M39,33h30a13,13 0 0 1 13,13v16a13,13 0 0 1 -13,13h-30a13,13 0 0 1 -13,-13v-16a13,13 0 0 1 13,-13z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M36,48 L45,60 L54,43 L63,65 L72,56"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>