<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层：白色日记卡片 + 卡片上的一条下降折线。

  构图说明：卡片占 23..85 × 25..83，整个落在中央 72×72 的安全区（18..90）内。
  自适应图标的前景会被系统蒙版裁掉外围，安全区外的东西不保证可见。

  折线颜色 #22BA74 比 App 内的主色 #3DD68C 更深一档 —— 白色卡片上要压得住，
  直接用主色会发飘。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 日记卡片 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M35,25h38a12,12 0 0 1 12,12v34a12,12 0 0 1 -12,12h-38a12,12 0 0 1 -12,-12v-34a12,12 0 0 1 12,-12z" />

    <!-- 卡片上的下降折线 -->
    <path
        android:pathData="M33,50 L43,61 L53,42 L64,67 L74,58"
        android:strokeColor="#FF22BA74"
        android:strokeWidth="5.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>